{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "questions", "brief", "error"],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["ask", "propose", "wait", "fail"]
    },
    "questions": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "blocking", "options", "recommended_option", "recommendation_reason"],
            "properties": {
              "question": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "blocking": { "type": "boolean" },
              "options": {
                "type": "array",
                "minItems": 0,
                "maxItems": 6,
                "items": { "type": "string", "minLength": 1, "maxLength": 300 }
              },
              "recommended_option": { "type": ["string", "null"], "maxLength": 300 },
              "recommendation_reason": { "type": ["string", "null"], "maxLength": 1000 }
            }
          }
        },
        { "type": "null" }
      ]
    },
    "brief": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "problem",
            "purpose",
            "background",
            "deliverables",
            "constraints",
            "out_of_scope",
            "assumptions",
            "open_questions",
            "next_action",
            "criteria",
            "provenance"
          ],
          "properties": {
            "problem": { "type": ["string", "null"] },
            "purpose": { "type": ["string", "null"] },
            "background": { "type": ["string", "null"] },
            "deliverables": { "type": ["array", "null"], "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "constraints": { "type": ["array", "null"], "items": { "type": "string" } },
            "out_of_scope": { "type": ["array", "null"], "items": { "type": "string" } },
            "assumptions": { "type": ["array", "null"], "items": { "type": "string" } },
            "open_questions": {
              "type": ["array", "null"],
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["text", "blocking"],
                "properties": {
                  "text": { "type": "string" },
                  "blocking": { "type": "boolean" }
                }
              }
            },
            "next_action": { "type": ["string", "null"] },
            "criteria": { "type": ["array", "null"], "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "provenance": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "problem",
                "purpose",
                "background",
                "deliverables",
                "constraints",
                "out_of_scope",
                "assumptions",
                "open_questions",
                "next_action",
                "criteria"
              ],
              "properties": {
                "problem": { "enum": ["user", "inference", "assumption", "unresolved", null] },
                "purpose": { "enum": ["user", "inference", "assumption", "unresolved", null] },
                "background": { "enum": ["user", "inference", "assumption", "unresolved", null] },
                "deliverables": { "enum": ["user", "inference", "assumption", "unresolved", null] },
                "constraints": { "enum": ["user", "inference", "assumption", "unresolved", null] },
                "out_of_scope": { "enum": ["user", "inference", "assumption", "unresolved", null] },
                "assumptions": { "enum": ["user", "inference", "assumption", "unresolved", null] },
                "open_questions": { "enum": ["user", "inference", "assumption", "unresolved", null] },
                "next_action": { "enum": ["user", "inference", "assumption", "unresolved", null] },
                "criteria": { "enum": ["user", "inference", "assumption", "unresolved", null] }
              }
            }
          }
        },
        { "type": "null" }
      ]
    },
    "error": {
      "anyOf": [
        { "type": "string", "maxLength": 1000 },
        { "type": "null" }
      ]
    }
  }
}
