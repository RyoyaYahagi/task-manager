# Copy to .env.local and fill in secrets locally. Do not commit .env.local.
# Local Jev Gateway endpoint. The Gateway owns the upstream TypeSafe credential.
JEV_GATEWAY_URL=http://127.0.0.1:4789/v1/systemone
# Set this only when the local Gateway was configured with JEV_GATEWAY_TOKEN.
# JEV_GATEWAY_TOKEN=
TM_JEV_MODEL=jev-latest
TM_JEV_TIMEOUT_MS=10000
# AI深掘りのJEV判定。Codexの選択肢再評価と深掘り案の検証に使う。
TM_JEV_REFINE_ENABLED=true
TM_JEV_REFINE_THRESHOLD=0.85
# Cost calculation uses TypeSafe's public input-token price by default.
# Set these only if your account has a different contract rate.
# TM_JEV_INPUT_USD_PER_MILLION=0.042
# TM_JEV_CACHED_INPUT_USD_PER_MILLION=0
# TM_JEV_OUTPUT_USD_PER_MILLION=0

# Optional overrides
# TM_CLASSIFICATION_CONFIG=config/classification.json
# TM_TOKEN=
# 設定行が未作成の場合の初期値。以後は「AI深掘り設定」画面の保存値を使う。
# CODEX_MODEL=gpt-5.6-luna
# CODEX_REASONING_EFFORT=max
# 外部ランナーはSSE通知を主に使い、起動時とこの間隔で未処理タスクを再確認する。
# CODEX_RUNNER_RECONCILE_MS=180000
# CODEX_RUNNER_TIMEOUT_MS=900000
# CODEX_INPUT_USD_PER_MILLION=0.20
# CODEX_CACHED_INPUT_USD_PER_MILLION=0.02
# CODEX_OUTPUT_USD_PER_MILLION=1.20
